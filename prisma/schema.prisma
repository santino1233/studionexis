generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Platform ──────────────────────────────────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

model Tenant {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  customDomain String?      @unique
  plan         String       @default("starter")
  status       TenantStatus @default(TRIAL)
  trialEndsAt  DateTime?
  currency     String       @default("USD")
  timezone     String       @default("Asia/Bangkok")
  language     String       @default("en")
  brandColor   String       @default("#F97316")
  logoUrl      String?
  policies     Json         @default("{}")
  website      Json         @default("{}")
  smsBalance   Decimal      @default(0) @db.Decimal(12, 4)
  apiKey       String?      @unique // nx_live_… — public REST API (Wave 15)
  organizationId String?    // set when this studio is one location of a franchise
  locationLabel  String?    // "Downtown", "Westside" — shown in the location switcher
  createdAt    DateTime     @default(now())

  users          User[]
  clients        Client[]
  classTypes     ClassType[]
  sessions       ClassSession[]
  bookings       Booking[]
  packages       Package[]
  clientPackages ClientPackage[]
  products       Product[]
  orders         Order[]
  expenses       Expense[]
  smsMessages    SmsMessage[]
  smsTopups      SmsTopup[]
  timeBlocks     TimeBlock[]
  pageViews      PageView[]
  supportTickets SupportTicket[]
  chats          ChatConversation[]
  organization   Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
}

model Organization {
  id         String   @id @default(cuid())
  name       String
  ownerEmail String?  // org owner; may switch between the org's locations
  policies   Json     @default("{}") // { sync: { clients, classTypes, sharedCredits, memberships, staff } }
  createdAt  DateTime @default(now())

  tenants Tenant[]
}

enum UserRole {
  OWNER
  MANAGER
  STAFF // front desk / reception
  INSTRUCTOR
  SUPERADMIN
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  phone        String?
  lastLoginAt  DateTime?
  role           UserRole @default(STAFF)
  baseSalary     Decimal  @default(0) @db.Decimal(12, 2) // per month
  hourlyRate     Decimal  @default(0) @db.Decimal(12, 2)
  commissionMode String   @default("percent") // percent | percent_tiered | fixed_per_class | per_head
  commissionRate Decimal  @default(0) @db.Decimal(5, 2) // % of class revenue (percent mode)
  commissionConfig Json   @default("{}") // tiers/fixed/per-head settings (Wave 11 Y4)
  active         Boolean  @default(true)
  createdAt    DateTime @default(now())

  sessionsTaught ClassSession[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ── Clients ───────────────────────────────────────────────────────────

model Client {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  email        String?
  passwordHash String? // set when the client creates a portal account
  channel      String?   // zalo / instagram / walk-in …
  tags         String[]  @default([])
  birthday     DateTime?
  medicalNotes String?
  notes        String?
  memberSince  DateTime  @default(now())
  lastVisitAt  DateTime?
  createdAt    DateTime  @default(now())

  bookings Booking[]
  packages ClientPackage[]
  orders   Order[]

  @@index([tenantId, name])
  @@index([tenantId, phone])
}

// ── Classes & scheduling ─────────────────────────────────────────────

enum ClassKind {
  GROUP
  PRIVATE
}

model ClassType {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  difficulty  String    @default("ALL_LEVELS") // legacy enum values or a studio-defined label
  format      String? // studio-defined format label (Mat, Reformer, Barre …)
  color       String    @default("#F97316")
  kind        ClassKind @default(GROUP)
  durationMin Int       @default(60)
  capacity    Int       @default(10)
  price       Decimal   @default(0) @db.Decimal(12, 2)
  active      Boolean   @default(true)
  // Blueprint richness (video spec X7)
  benefits    String[]  @default([])
  goodFor     String[]  @default([])
  tags        String[]  @default([])
  equipment   String[]  @default([])
  muscles     String[]  @default([]) // MuscleMap slugs, e.g. abs, obliques
  heroImage   String?
  defaultInstructorId String?
  publicByDefault     Boolean  @default(true)
  validFrom           DateTime?
  validTo             DateTime?
  recurringSlots      Json     @default("[]") // [{day:0-6(Mon=0), time:"HH:MM", cap?:n}]
  exceptionDates      String[] @default([]) // "YYYY-MM-DD" skipped by the materialiser

  sessions ClassSession[]

  @@index([tenantId])
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  BLOCKED
}

model ClassSession {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classTypeId  String
  classType    ClassType     @relation(fields: [classTypeId], references: [id])
  instructorId String?
  instructor   User?         @relation(fields: [instructorId], references: [id])
  startsAt     DateTime
  endsAt       DateTime
  capacity     Int
  location     String?
  status       SessionStatus @default(SCHEDULED)
  isPublic     Boolean       @default(true)
  note         String?
  revenue            Decimal? @db.Decimal(12, 2) // frozen when marked completed
  instructorEarnings Decimal? @db.Decimal(12, 2)

  bookings Booking[]

  @@index([tenantId, startsAt])
}

enum BookingStatus {
  BOOKED
  CHECKED_IN
  CANCELLED
  LATE_CANCEL
  WAITLIST
  NO_SHOW
}

model Booking {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessionId       String
  session         ClassSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  status          BookingStatus  @default(BOOKED)
  qty             Int            @default(1) // spots taken (client + guests)
  paymentMethod   String? // package_credit / online / at_studio
  clientPackageId String?
  clientPackage   ClientPackage? @relation(fields: [clientPackageId], references: [id])
  orderId         String? // set when the attendee is checked out at the desk
  order           Order?         @relation(fields: [orderId], references: [id])
  remindedAt      DateTime?
  createdAt       DateTime       @default(now())

  @@unique([sessionId, clientId])
  @@index([tenantId, createdAt])
}

// ── Packages, products, sales ────────────────────────────────────────

model Package {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  credits      Int
  validityDays Int     @default(90)
  price        Decimal @db.Decimal(12, 2)
  kind         ClassKind @default(GROUP)
  interval     String  @default("none") // none = one-time pack | month | year = auto-renewing membership
  active       Boolean @default(true)

  purchases ClientPackage[]

  @@index([tenantId])
}

model ClientPackage {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  packageId   String
  package     Package   @relation(fields: [packageId], references: [id])
  creditsLeft Int
  expiresAt   DateTime
  frozen      Boolean   @default(false)
  pricePaid   Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())

  bookings Booking[]

  @@index([tenantId, clientId])
}

model Product {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  price    Decimal @db.Decimal(12, 2)
  stock    Int     @default(0) // ignored when variants exist (their stock rules)
  imageUrl String?
  active   Boolean @default(true)

  orderItems OrderItem[]
  variants   ProductVariant[]

  @@index([tenantId])
}

// Size/colour/pack options with their own stock (Wave 14 V3).
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String // "Black · M", "3-Pack"…
  price     Decimal? @db.Decimal(12, 2) // null = product price
  stock     Int     @default(0)

  @@index([productId])
}

enum OrderStatus {
  PAID
  PENDING
  REFUNDED
  VOID
}

model Order {
  id        String      @id @default(cuid())
  tenantId  String
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?     @relation(fields: [clientId], references: [id])
  number    Int
  total     Decimal     @db.Decimal(12, 2)
  discount  Decimal     @default(0) @db.Decimal(12, 2)
  voucherId String?
  voucher   Voucher?    @relation(fields: [voucherId], references: [id])
  method    String // cash / transfer / card / online / stripe / membership
  status    OrderStatus @default(PAID)
  stripeSessionId String? @unique // set when paid through Stripe Checkout
  createdAt DateTime    @default(now())

  items    OrderItem[]
  bookings Booking[]

  @@unique([tenantId, number])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String // package / product / dropin
  refId     String? // packageId or productId
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  label     String
  qty       Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 2)
}

// ── Money ─────────────────────────────────────────────────────────────

model Expense {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category String
  amount   Decimal  @db.Decimal(12, 2)
  note     String?
  date     DateTime @default(now())

  @@index([tenantId, date])
}

model EmailLog {
  id        String   @id @default(cuid())
  tenantId  String
  to        String
  subject   String
  body      String
  status    String // sent | skipped | failed
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

enum VoucherType {
  PERCENT
  FIXED
}

model Voucher {
  id        String      @id @default(cuid())
  tenantId  String
  code      String
  type      VoucherType @default(PERCENT)
  value     Decimal     @db.Decimal(12, 2)
  maxUses   Int         @default(100)
  usedCount Int         @default(0)
  expiresAt DateTime?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  orders Order[]

  @@unique([tenantId, code])
}

// ── SMS (Twilio pay-as-you-go, +10% platform markup on usage) ─────────

model SmsTopup {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("PENDING") // PENDING | PAID
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model SmsMessage {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  to          String
  body        String
  kind        String   @default("notification") // confirmation | reminder | …
  status      String // SENT | DELIVERED | FAILED | SKIPPED_NO_CREDS | SKIPPED_NO_CREDits…
  sid         String?  @unique
  estCharge   Decimal  @default(0) @db.Decimal(12, 4) // deducted at send (marked up)
  finalCharge Decimal? @db.Decimal(12, 4) // reconciled from Twilio price (marked up)
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

// Studio-blocked time ranges (maintenance, holidays, private events).
model TimeBlock {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([tenantId, startsAt])
}

// First-party visitor analytics for the public site + booking pages (Wave 12 Z7).
model PageView {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitorId String // anonymous nx_vid cookie
  path      String
  source    String? // utm_source or classified referrer (instagram/google/…)
  referrer  String?
  device    String? // mobile | desktop
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, visitorId, createdAt])
}

// ── HQ Super-Admin CRM (Wave 16) ──────────────────────────────────────

model SupportTicket {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind      String   @default("support") // support | bug
  subject   String
  status    String   @default("OPEN") // OPEN | PENDING | WAITING | RESOLVED
  priority  String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  assignee  String?
  context   Json     @default("{}") // auto-captured url/browser/screen/user
  githubIssue   String?
  fixVersion    String?
  internalNotes String?
  messages  Json     @default("[]") // [{from:"studio"|"hq", name, text, at}]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, priority])
  @@index([tenantId, createdAt])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  kind        String    @default("info") // info | maintenance | security | release
  audience    Json      @default("{}") // {all, trial, plans[], tenantIds[]}
  activeFrom  DateTime  @default(now())
  activeUntil DateTime?
  createdAt   DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  actor     String
  role      String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([tenantId, createdAt])
}

model Release {
  id          String   @id @default(cuid())
  version     String
  title       String
  notes       String
  publishedAt DateTime @default(now())
}

model KbArticle {
  id        String   @id @default(cuid())
  title     String
  body      String
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GlobalSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Native live chat — Tidio-style visitor ↔ studio messaging (2026-07-17).
model ChatConversation {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visitorId     String // nx_vid cookie ("hq" for studio<->Nexis support chats)
  channel       String   @default("visitor") // visitor | hq
  clientId      String? // linked once the visitor is a known client
  name          String?
  contact       String? // email/phone the visitor leaves
  status        String   @default("OPEN") // OPEN | CLOSED
  messages      Json     @default("[]") // [{from:"visitor"|"studio", name, text, at}]
  unreadStudio  Int      @default(0)
  unreadVisitor Int      @default(0)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([tenantId, lastMessageAt])
  @@index([tenantId, visitorId])
  @@index([channel, lastMessageAt])
}
